def process_pin(message, name, phone, referrer):
    pin = message.text
    if len(pin) == 4 and pin.isdigit():
        cursor.execute("INSERT INTO users VALUES (?, ?, ?, ?, ?, ?)", (message.from_user.id, name, phone, pin, 0.0, referrer))
        conn.commit()
        bot.send_message(message.chat.id, "✅ অ্যাকাউন্ট সফল! এখন /start দিন।")
    else:
        bot.send_message(message.chat.id, "❌ পিন অবশ্যই ৪ সংখ্যার হতে হবে।")

def check_pin(message):
    user = get_user(message.from_user.id)
    if user and message.text == user[3]:
        markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
        markup.add("📧 জিমেইল জমা দিন", "💰 ব্যালেন্স")
        markup.add("👥 রেফার করুন", "🏧 উইথড্র")
        bot.send_message(message.chat.id, "ড্যাশবোর্ড মেনু:", reply_markup=markup)
    else:
        bot.send_message(message.chat.id, "❌ ভুল পিন! আবার /start দিন।")

