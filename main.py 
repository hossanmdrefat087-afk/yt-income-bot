@bot.message_handler(func=lambda message: message.text == "📧 জিমেইল জমা দিন")
def work_start(message):
    current_pass = get_current_pass()
    msg = f"নিচের পাসওয়ার্ডটি ব্যবহার করে জিমেইল খুলুন:\n\nপাসওয়ার্ড: `{current_pass}`\n\nজিমেইলটি খোলা হয়ে গেলে শুধুমাত্র ইমেইলটি এখানে পাঠান।"
    bot.send_message(message.chat.id, msg, parse_mode="Markdown")
    bot.register_next_step_handler(message, handle_gmail)

def handle_gmail(message):
    email = message.text.strip().lower()
    if "@gmail.com" not in email:
        bot.send_message(message.chat.id, "❌ ভুল ফরম্যাট! সঠিক জিমেইল দিন।")
        return
    
    cursor.execute("INSERT INTO work (user_id, email, status) VALUES (?, ?, ?)", (message.from_user.id, email, 'pending'))
    conn.commit()
    work_id = cursor.lastrowid
    
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("Approve", callback_data=f"app_{work_id}_{message.from_user.id}"),
               types.InlineKeyboardButton("Reject", callback_data=f"rej_{work_id}_{message.from_user.id}"))
    
    bot.send_message(ADMIN_ID, f"নতুন কাজ জমা হয়েছে!\nইউজার আইডি: {message.from_user.id}\nইমেইল: {email}\nব্যবহৃত পাসওয়ার্ড: {get_current_pass()}", reply_markup=markup)
    bot.send_message(message.chat.id, "📩 জমা হয়েছে! অ্যাডমিন চেক করলে ৮ টাকা পাবেন।")

# --- অ্যাডমিন অ্যাকশন ---
@bot.callback_query_handler(func=lambda call: True)
def admin_action(call):
    data = call.data.split('_')
    if data[0] == "app":
        cursor.execute("UPDATE users SET balance = balance + 8 WHERE id=?", (data[2],))
        cursor.execute("SELECT referred_by FROM users WHERE id=?", (data[2],))
        res = cursor.fetchone()
        if res and res[0]:
            cursor.execute("UPDATE users SET balance = balance + 1 WHERE id=?", (res[0],))
        conn.commit()
        bot.edit_message_text("✅ Approved", call.message.chat.id, call.message.message_id)
        bot.send_message(data[2], "💰 অভিনন্দন! আপনার ৮ টাকা ব্যালেন্সে যোগ হয়েছে।")
    else:
        bot.edit_message_text("❌ Rejected", call.message.chat.id, call.message.message_id)
        bot.send_message(data[2], "❌ আপনার জমা দেওয়া জিমেইলটি রিজেক্ট করা হয়েছে।")

